# Local dev defaults point at each app's Vite dev server - see
# APP_REGISTRY fallback values in src/config/apps.ts.
# For a deployed environment, point these at the platform's own
# domain + the app's asset path (CloudFront routes it to that app's
# S3 bucket - see README.md).
VITE_APP_ONE_URL=https://summit-platform.summitcreditunion.io/assets/app-one/remoteEntry.js
VITE_APP_TWO_URL=https://summit-platform.summitcreditunion.io/assets/app-two/remoteEntry.js
